<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Preservar cabecera Authorization para el panel /admin
  RewriteCond %{HTTP:Authorization} ^(.*)
  RewriteRule .* - [e=HTTP_AUTHORIZATION:%1]

  # Excluir carpetas físicas del backend PHP y eventos de clientes
  RewriteRule ^api/ - [L]
  RewriteRule ^eventos/ - [L]

  # Servir archivos o directorios físicos existentes
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Redirigir cualquier ruta SPA (/:slug, /:slug/album, /admin) a index.html
  RewriteRule ^ index.html [L]
</IfModule>

# Ampliar límites de subida en PHP (si el servidor Apache/Hostinger lo permite)
<IfModule mod_php.c>
  php_value upload_max_filesize 128M
  php_value post_max_size 132M
  php_value max_execution_time 300
  php_value max_input_time 300
</IfModule>

# =========================================================================
# CONTROL DE CACHÉ (EVITA QUE LOS NAVEGADORES GUARDEN VERSIONES VIEJAS)
# =========================================================================
<IfModule mod_headers.c>
  # 1. NUNCA cachear index.html ni version.json
  <FilesMatch "^(index\.html|version\.json)?$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # 2. NUNCA cachear respuestas dinámicas de PHP (/api/*.php)
  <FilesMatch "\.php$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
    Header set Pragma "no-cache"
    Header set Expires "0"
  </FilesMatch>

  # 3. Cachear 1 año los bundles con hash generados por Vite (/assets/*.js, *.css)
  <FilesMatch "\.(js|css)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>
